---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

export function getStaticPaths() {
  return [];
}

const { zip } = Astro.params;
---

<Layout
  title={`Water Quality Report for ${zip} | Raleigh Water Solutions`}
  description={`See what's in your tap water for ZIP code ${zip}. Personalized contaminant report and filter recommendations.`}
>
  <Navbar />

  <div id="report-container">
    <!-- Loading State -->
    <section class="pt-32 pb-20 min-h-screen flex items-center justify-center">
      <div class="text-center">
        <div class="animate-spin rounded-full h-16 w-16 border-b-2 border-primary mx-auto mb-4"></div>
        <p class="text-gray-600">Loading your water report...</p>
      </div>
    </section>
  </div>

  <Footer />

  <script define:vars={{ zip }}>
    // Get data from session
    const waterData = JSON.parse(sessionStorage.getItem('waterReportData') || '{}');
    const contactData = JSON.parse(sessionStorage.getItem('waterReportContact') || '{}');

    if (!waterData || !waterData.contaminants) {
      window.location.href = '/water-report';
    }

    // Generate report HTML
    const container = document.getElementById('report-container');
    if (container && waterData.contaminants) {
      container.innerHTML = `
        <!-- Hero Section -->
        <section class="pt-28 pb-12 bg-gradient-to-br from-primary to-secondary">
          <div class="max-w-4xl mx-auto container-padding text-center">
            <span class="inline-block bg-white/20 text-white text-sm font-medium px-4 py-1 rounded-full mb-4">
              Your Water Quality Report
            </span>

            <h1 class="text-4xl md:text-5xl font-bold text-white mb-4">
              ${waterData.city || 'Your Area'}
              <span class="text-accent">Water Analysis</span>
            </h1>

            <p class="text-xl text-white/90 mb-6">ZIP Code: ${zip}</p>

            <!-- Score Card -->
            <div class="inline-block bg-white rounded-3xl p-8 shadow-2xl">
              <div class="text-sm text-gray-500 uppercase tracking-wider mb-2">Overall Grade</div>
              <div class="text-7xl font-bold ${getGradeColor(waterData.grade)} mb-2">${waterData.grade}</div>
              <div class="text-lg font-medium text-gray-700">${waterData.riskLevel === 'high' ? 'High Risk' : waterData.riskLevel === 'moderate' ? 'Moderate Risk' : 'Low Risk'}</div>
              <div class="text-sm text-gray-500 mt-2">Safety Score: ${waterData.riskScore}/100</div>
            </div>
          </div>
        </section>

        <!-- Contaminants Section -->
        <section class="py-16 bg-white">
          <div class="max-w-4xl mx-auto container-padding">
            <h2 class="text-3xl font-bold text-center text-gray-900 mb-4">
              Contaminants Found in Your <span class="gradient-text">Water</span>
            </h2>
            <p class="text-gray-600 text-center mb-12 max-w-2xl mx-auto">
              Based on EPA data for your area. These are the most concerning contaminants detected in your water supply.
            </p>

            <div class="space-y-6">
              ${waterData.contaminants.map((c, i) => `
                <div class="bg-gray-50 rounded-2xl p-6 border-l-4 ${getRiskBorder(c.riskLevel)}" style="animation: fadeIn 0.5s ease-out ${i * 0.1}s forwards; opacity: 0;">
                  <div class="flex flex-col md:flex-row md:items-start gap-4">
                    <div class="flex-shrink-0">
                      <div class="w-12 h-12 rounded-xl ${getRiskBg(c.riskLevel)} flex items-center justify-center text-2xl">
                        ${getContaminantIcon(c.category)}
                      </div>
                    </div>
                    <div class="flex-1">
                      <div class="flex flex-col md:flex-row md:items-center gap-2 mb-2">
                        <h3 class="text-xl font-bold text-gray-900">${c.name}</h3>
                        <span class="inline-block px-3 py-1 rounded-full text-sm font-medium ${getRiskBadge(c.riskLevel)}">
                          ${c.riskLevel.charAt(0).toUpperCase() + c.riskLevel.slice(1)} Risk
                        </span>
                      </div>
                      <p class="text-gray-600 text-sm mb-3">${c.category}</p>

                      <div class="grid md:grid-cols-3 gap-4 bg-white rounded-xl p-4">
                        <div>
                          <div class="text-sm text-gray-500">Detected Level</div>
                          <div class="text-lg font-bold text-gray-900">${c.level} ${c.unit}</div>
                        </div>
                        <div>
                          <div class="text-sm text-gray-500">EPA Limit</div>
                          <div class="text-lg font-bold text-gray-900">${c.mcl}</div>
                        </div>
                        <div>
                          <div class="text-sm text-gray-500">Status</div>
                          <div class="text-lg font-bold ${getLevelStatus(c.level, c.mcl) ? 'text-red-600' : 'text-green-600'}">
                            ${getLevelStatus(c.level, c.mcl) ? 'Above Limit' : 'Within Limit'}
                          </div>
                        </div>
                      </div>

                      <div class="mt-4 p-4 bg-yellow-50 rounded-lg">
                        <div class="text-sm font-medium text-gray-700 mb-1">Health Concerns:</div>
                        <div class="text-sm text-gray-600">${c.healthEffects}</div>
                      </div>
                    </div>
                  </div>
                </div>
              `).join('')}
            </div>
          </div>
        </section>

        <!-- Recommendation Section -->
        <section class="py-16 bg-gray-50">
          <div class="max-w-4xl mx-auto container-padding">
            <div class="bg-white rounded-3xl p-8 md:p-12 shadow-xl">
              <div class="text-center mb-8">
                <h2 class="text-3xl font-bold text-gray-900 mb-4">
                  Recommended <span class="gradient-text">Solution</span>
                </h2>
                <p class="text-gray-600">
                  Based on your water analysis, here's the best system for your home:
                </p>
              </div>

              <div class="bg-gradient-to-br from-primary/5 to-secondary/5 rounded-2xl p-8 border-2 border-primary/20">
                <div class="flex items-center gap-4 mb-6">
                  <div class="w-16 h-16 rounded-2xl bg-primary flex items-center justify-center text-white text-3xl">
                    💧
                  </div>
                  <div>
                    <h3 class="text-2xl font-bold text-gray-900">${getRecommendation(waterData.contaminants)}</h3>
                    <p class="text-primary font-medium">Best for your water profile</p>
                  </div>
                </div>

                <ul class="space-y-3 mb-8">
                  ${getRecommendationFeatures(waterData.contaminants).map(f => `
                    <li class="flex items-center gap-3">
                      <svg class="w-5 h-5 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                      </svg>
                      <span class="text-gray-700">${f}</span>
                    </li>
                  `).join('')}
                </ul>

                <a href="/contact?source=water-report&zip=${zip}&system=${encodeURIComponent(getRecommendation(waterData.contaminants))}"
                   class="btn-primary w-full md:w-auto text-center block md:inline-block">
                  Get Free Quote
                </a>
              </div>
            </div>
          </div>
        </section>

        <!-- CTA Section -->
        <section class="py-16 bg-primary">
          <div class="max-w-4xl mx-auto container-padding text-center">
            <h2 class="text-3xl font-bold text-white mb-4">
              Want Clean, Safe Water?
            </h2>
            <p class="text-xl text-white/90 mb-8">
              Schedule a free water test to see exactly what's coming out of your taps.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
              <a href="tel:+19195551234" class="px-8 py-4 bg-white text-primary font-semibold rounded-lg hover:bg-gray-100 transition-colors">
                Call (919) 555-0123
              </a>
              <a href="/contact?source=water-report&zip=${zip}" class="px-8 py-4 bg-white/20 text-white font-semibold rounded-lg hover:bg-white/30 transition-colors">
                Schedule Free Test
              </a>
            </div>
          </div>
        </section>
      `;
    }

    function getGradeColor(grade) {
      const colors = { A: 'text-green-500', B: 'text-yellow-500', C: 'text-orange-500', D: 'text-red-500', F: 'text-red-700' };
      return colors[grade] || 'text-gray-500';
    }

    function getRiskBorder(risk) {
      return risk === 'high' ? 'border-red-500' : risk === 'moderate' ? 'border-yellow-500' : 'border-green-500';
    }

    function getRiskBg(risk) {
      return risk === 'high' ? 'bg-red-100' : risk === 'moderate' ? 'bg-yellow-100' : 'bg-green-100';
    }

    function getRiskBadge(risk) {
      return risk === 'high' ? 'bg-red-100 text-red-700' : risk === 'moderate' ? 'bg-yellow-100 text-yellow-700' : 'bg-green-100 text-green-700';
    }

    function getContaminantIcon(category) {
      const icons = {
        'Disinfection Byproduct': '⚗️',
        'Industrial Chemical': '🏭',
        'Mineral': '💎',
        'Heavy Metal': '⚠️',
        'Microbial': '🦠'
      };
      return icons[category] || '💧';
    }

    function getLevelStatus(level, mcl) {
      if (mcl === 'N/A') return false;
      const numLevel = parseFloat(level);
      const numMCL = parseFloat(mcl);
      return !isNaN(numLevel) && !isNaN(numMCL) && numLevel > numMCL;
    }

    function getRecommendation(contaminants) {
      const hasPFAS = contaminants?.some(c => c.name.includes('PFAS'));
      const hasLead = contaminants?.some(c => c.name.includes('Lead'));
      const hasHardness = contaminants?.some(c => c.name.includes('Hardness'));

      if (hasPFAS || hasLead) return 'Complete Home System + Reverse Osmosis';
      if (hasHardness) return 'Complete Home System';
      return 'Water Softener Pro';
    }

    function getRecommendationFeatures(contaminants) {
      const hasPFAS = contaminants?.some(c => c.name.includes('PFAS'));
      const hasLead = contaminants?.some(c => c.name.includes('Lead'));

      const baseFeatures = [
        'Removes 99% of common contaminants',
        'Lifetime warranty included',
        'Professional installation',
        'NSF certified components'
      ];

      if (hasPFAS) baseFeatures.unshift('Advanced PFAS filtration technology');
      if (hasLead) baseFeatures.unshift('Lead removal certification');

      return baseFeatures;
    }
  </script>

  <style>
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>
</Layout>
