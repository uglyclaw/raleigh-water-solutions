---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="Free Water Quality Report | Raleigh Water Solutions"
  description="See what's really in your tap water. Get a personalized water quality report for your ZIP code."
>
  <Navbar />

  <section class="pt-32 pb-20 bg-gradient-to-br from-primary to-secondary min-h-[80vh] flex items-center">
    <div class="max-w-4xl mx-auto container-padding text-center">
      <!-- Trust Badge -->
      <div class="inline-flex items-center gap-2 bg-white/20 text-white px-4 py-2 rounded-full mb-8">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        <span class="text-sm font-medium">Over 95% of US water systems tested exceeded safe limits</span>
      </div>

      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
        What's Really In Your
        <span class="text-accent">Tap Water?</span>
      </h1>

      <p class="text-xl text-white/90 mb-12 max-w-2xl mx-auto">
        Enter your email below to get your personalized water quality report.
        See exactly what contaminants are in your water and how to fix them.
      </p>

      <!-- Email Form -->
      <form id="email-form" class="max-w-md mx-auto">
        <div class="bg-white rounded-2xl p-2 shadow-2xl">
          <div class="flex flex-col sm:flex-row gap-2">
            <input
              type="email"
              id="email"
              name="email"
              placeholder="Enter your email address"
              required
              class="flex-1 px-6 py-4 text-gray-900 placeholder-gray-400 border-0 focus:ring-0 text-lg"
            />
            <button
              type="submit"
              class="px-8 py-4 bg-primary text-white font-semibold rounded-xl hover:bg-primary-dark transition-colors whitespace-nowrap"
            >
              Get My Report →
            </button>
          </div>
        </div>

        <!-- Error Message -->
        <p id="error-msg" class="text-red-300 mt-4 hidden">Please enter a valid email address.</p>
      </form>

      <!-- Trust Indicators -->
      <div class="mt-12 flex flex-wrap justify-center gap-8 text-white/80">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/>
          </svg>
          <span class="text-sm">Secure & Confidential</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9 2a1 1 0 000 2h2a1 1 0 100-2H9z"/>
            <path fill-rule="evenodd" d="M4 5a2 2 0 012-2 3 3 0 003 3h2a3 3 0 003-3 2 2 0 012 2v11a2 2 0 01-2 2H6a2 2 0 01-2-2V5zm3 4a1 1 0 000 2h.01a1 1 0 100-2H7zm3 0a1 1 0 000 2h3a1 1 0 100-2h-3zm-3 4a1 1 0 100 2h.01a1 1 0 100-2H7zm3 0a1 1 0 100 2h3a1 1 0 100-2h-3z" clip-rule="evenodd"/>
          </svg>
          <span class="text-sm">Instant Report</span>
        </div>
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
          </svg>
          <span class="text-sm">EPA Data Sources</span>
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <script>
    const form = document.getElementById('email-form');
    const emailInput = document.getElementById('email');
    const errorMsg = document.getElementById('error-msg');

    form?.addEventListener('submit', (e) => {
      e.preventDefault();

      const email = emailInput?.value.trim();

      if (!email || !email.includes('@')) {
        errorMsg?.classList.remove('hidden');
        return;
      }

      errorMsg?.classList.add('hidden');

      // Store email and redirect to step 2
      sessionStorage.setItem('waterReportEmail', email);
      window.location.href = '/water-report/step-2';
    });
  </script>

</Layout>
