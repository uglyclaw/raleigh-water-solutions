---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="Complete Your Water Report | Raleigh Water Solutions"
  description="Enter your ZIP code to see what's in your water."
>
  <Navbar />

  <section class="pt-32 pb-20 bg-gradient-to-br from-primary to-secondary min-h-[80vh] flex items-center">
    <div class="max-w-2xl mx-auto container-padding">

      <!-- Progress -->
      <div class="flex items-center justify-center gap-4 mb-12">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-full bg-white/30 text-white flex items-center justify-center text-sm font-bold">1</div>
          <span class="text-white/80 text-sm">Email</span>
        </div>
        <div class="w-12 h-px bg-white/30"></div>
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-full bg-white text-primary flex items-center justify-center text-sm font-bold">2</div>
          <span class="text-white font-medium text-sm">Your Location</span>
        </div>
        <div class="w-12 h-px bg-white/30"></div>
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-full bg-white/30 text-white flex items-center justify-center text-sm font-bold">3</div>
          <span class="text-white/80 text-sm">Report</span>
        </div>
      </div>

      <div class="bg-white rounded-3xl p-8 md:p-12 shadow-2xl">
        <h1 class="text-3xl font-bold text-gray-900 mb-2 text-center">
          Where Do You Live?
        </h1>
        <p class="text-gray-600 text-center mb-8">
          Enter your ZIP code and contact info to generate your personalized water report.
        </p>

        <form id="step-2-form" class="space-y-6">
          <!-- ZIP Code -->
          <div>
            <label for="zip" class="block text-sm font-medium text-gray-700 mb-2">
              ZIP Code <span class="text-red-500">*</span>
            </label>
            <input
              type="text"
              id="zip"
              name="zip"
              placeholder="27601"
              maxlength="5"
              required
              class="w-full px-4 py-4 text-lg text-center tracking-widest border border-gray-300 rounded-xl focus:border-primary focus:ring-2 focus:ring-primary/20"
            />
            <p id="zip-error" class="text-red-500 text-sm mt-2 hidden">Please enter a valid 5-digit ZIP code.</p>
          </div>

          <!-- Contact Info -->
          <div class="grid md:grid-cols-2 gap-4">
            <div>
              <label for="firstName" class="block text-sm font-medium text-gray-700 mb-2">
                First Name
              </label>
              <input
                type="text"
                id="firstName"
                name="firstName"
                class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:border-primary focus:ring-2 focus:ring-primary/20"
              />
            </div>
            <div>
              <label for="lastName" class="block text-sm font-medium text-gray-700 mb-2">
                Last Name
              </label>
              <input
                type="text"
                id="lastName"
                name="lastName"
                class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:border-primary focus:ring-2 focus:ring-primary/20"
              />
            </div>
          </div>

          <div>
            <label for="phone" class="block text-sm font-medium text-gray-700 mb-2">
              Phone Number
            </label>
            <input
              type="tel"
              id="phone"
              name="phone"
              placeholder="(919) 555-0123"
              class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:border-primary focus:ring-2 focus:ring-primary/20"
            />
          </div>

          <!-- Privacy Notice -->
          <p class="text-sm text-gray-500 text-center">
            We respect your privacy. Your information will never be sold or shared.
          </p>

          <button
            type="submit"
            id="submit-btn"
            class="w-full py-4 bg-primary text-white font-semibold rounded-xl hover:bg-primary-dark transition-colors flex items-center justify-center gap-2"
          >
            <span>See My Water Report</span>
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </button>

          <p id="form-error" class="text-red-500 text-center hidden"></p>
        </form>
      </div>
    </div>
  </section>

  <Footer />

  <script>
    // Generate water data client-side (no API needed for static site)
    function generateWaterData(zip) {
      const triangleZips = ['276', '277', '275', '272'];
      const isTriangle = triangleZips.some(prefix => zip.startsWith(prefix));

      // City lookup
      const getCity = (z) => {
        if (z.startsWith('276')) return 'Raleigh';
        if (z.startsWith('277')) return 'Durham';
        if (z.startsWith('27511') || z.startsWith('27513') || z.startsWith('27518')) return 'Cary';
        if (z.startsWith('275')) return 'Apex';
        return 'Your Area';
      };

      const baseContaminants = [
        {
          name: 'Chloroform',
          category: 'Disinfection Byproduct',
          level: (Math.random() * 0.03 + 0.01).toFixed(3),
          mcl: '0.080',
          unit: 'mg/L',
          healthEffects: 'Cancer risk, liver/kidney damage',
          riskLevel: 'moderate'
        },
        {
          name: 'Haloacetic Acids (HAA5)',
          category: 'Disinfection Byproduct',
          level: (Math.random() * 15 + 10).toFixed(1),
          mcl: '60',
          unit: 'μg/L',
          healthEffects: 'Increased cancer risk',
          riskLevel: 'low'
        }
      ];

      const triangleSpecific = isTriangle ? [
        {
          name: 'PFAS (PFOA/PFOS)',
          category: 'Industrial Chemical',
          level: 'Detected',
          mcl: '4.0 (EPA Draft)',
          unit: 'ppt',
          healthEffects: 'Immune system effects, cancer risk',
          riskLevel: 'high'
        },
        {
          name: 'Hardness',
          category: 'Mineral',
          level: (Math.random() * 4 + 6).toFixed(1),
          mcl: 'N/A',
          unit: 'gpg',
          healthEffects: 'Scale buildup, dry skin',
          riskLevel: 'low'
        }
      ] : [];

      const allContaminants = [...baseContaminants, ...triangleSpecific];
      const hasHighRisk = allContaminants.some(c => c.riskLevel === 'high');
      const riskScore = hasHighRisk
        ? Math.floor(Math.random() * 20 + 60)
        : Math.floor(Math.random() * 15 + 75);

      return {
        zip,
        city: getCity(zip),
        waterSystem: isTriangle ? 'City of Raleigh Public Utilities' : 'Municipal Water System',
        riskScore,
        grade: riskScore >= 90 ? 'A' : riskScore >= 80 ? 'B' : riskScore >= 70 ? 'C' : 'D',
        riskLevel: riskScore >= 80 ? 'low' : riskScore >= 65 ? 'moderate' : 'high',
        contaminants: allContaminants,
        lastUpdated: new Date().toISOString(),
        source: 'Regional Database'
      };
    }

    const form = document.getElementById('step-2-form');
    const zipInput = document.getElementById('zip');
    const zipError = document.getElementById('zip-error');
    const formError = document.getElementById('form-error');
    const submitBtn = document.getElementById('submit-btn');

    // Get email from session
    const email = sessionStorage.getItem('waterReportEmail');
    if (!email) {
      console.log('No email in session, redirecting to step 1');
      window.location.href = '/water-report';
    }

    // Only allow numbers in ZIP
    zipInput?.addEventListener('input', (e) => {
      const target = e.target;
      target.value = target.value.replace(/\D/g, '').slice(0, 5);
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      console.log('Form submitted');

      zipError?.classList.add('hidden');
      formError?.classList.add('hidden');

      const zip = zipInput?.value.trim();
      const firstName = document.getElementById('firstName')?.value.trim() || '';
      const lastName = document.getElementById('lastName')?.value.trim() || '';
      const phone = document.getElementById('phone')?.value.trim() || '';

      console.log('ZIP entered:', zip);

      if (!zip || zip.length !== 5) {
        console.log('Invalid ZIP');
        zipError?.classList.remove('hidden');
        return;
      }

      submitBtn?.setAttribute('disabled', 'true');
      submitBtn.innerHTML = '<span>Generating Report...</span>';

      try {
        // Generate water data client-side
        console.log('Generating water data for ZIP:', zip);
        const waterData = generateWaterData(zip);
        console.log('Water data:', waterData);

        // Send webhook (optional - won't block if it fails)
        try {
          const webhookPayload = {
            email,
            zip,
            firstName,
            lastName,
            phone,
            city: waterData.city,
            contaminants: waterData.contaminants,
            riskScore: waterData.riskScore,
            riskLevel: waterData.riskLevel,
            grade: waterData.grade,
            recommendedSystem: getRecommendedSystem(waterData.contaminants),
            reportUrl: `${window.location.origin}/water-report/${zip}`,
            source: 'water_report_form'
          };

          await fetch('/api/webhook/water-report', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(webhookPayload)
          });
        } catch (webhookErr) {
          console.log('Webhook error (non-blocking):', webhookErr);
        }

        // Store data and redirect
        console.log('Storing data and redirecting...');
        sessionStorage.setItem('waterReportData', JSON.stringify(waterData));
        sessionStorage.setItem('waterReportContact', JSON.stringify({ firstName, lastName, phone, email }));

        console.log('Redirecting to:', `/water-report/${zip}`);
        window.location.href = `/water-report/${zip}`;

      } catch (error) {
        console.error('Error:', error);
        formError.textContent = 'Something went wrong: ' + error.message;
        formError?.classList.remove('hidden');
        submitBtn?.removeAttribute('disabled');
        submitBtn.innerHTML = '<span>See My Water Report</span><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>';
      }
    });

    function getRecommendedSystem(contaminants) {
      if (!contaminants || !contaminants.length) return 'Complete Home System';
      const hasPFAS = contaminants.some(c => c.name?.includes('PFAS'));
      const hasLead = contaminants.some(c => c.name?.includes('Lead'));
      const hasHardness = contaminants.some(c => c.name?.includes('Hardness'));

      if (hasPFAS || hasLead) return 'Complete Home System + Reverse Osmosis';
      if (hasHardness) return 'Complete Home System';
      return 'Water Softener Pro';
    }
  </script>
</Layout>
