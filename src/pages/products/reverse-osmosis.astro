---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="Reverse Osmosis System | Raleigh Water Solutions"
  description="Drinking water filtration system for Raleigh homes. Removes 99% of contaminants including lead, PFAS, chlorine. 5-stage filtration with alkaline option."
>
  <Navbar />

  <section class="pt-32 pb-20 bg-gradient-to-br from-primary to-secondary">
    <div class="max-w-7xl mx-auto container-padding">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
            Reverse Osmosis
            <span class="text-accent">Drinking System</span>
          </h1>
          <p class="text-xl text-white/90 mb-8">
            Crystal-clear drinking water right from your kitchen tap. Removes 99% of contaminants
            including lead, PFAS, chlorine, and pharmaceuticals.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="#contact" class="btn-primary bg-white text-primary hover:bg-gray-100">
              Get Free Quote
            </a>
            <a href="tel:+19195551234" class="px-8 py-4 border-2 border-white text-white font-semibold rounded-lg hover:bg-white/10 transition-colors text-center">
              Call (919) 555-0123
            </a>
          </div>
        </div>
        <div class="bg-white/10 backdrop-blur-sm rounded-3xl p-8 border border-white/20">
          <img src="/images/products/tankless-ro.png" alt="Reverse Osmosis System" class="w-full max-w-xs mx-auto mb-4 rounded-xl" />
          <div class="text-center">
            <div class="text-white text-lg mb-2">99% Contaminant Removal</div>
            <div class="text-accent text-3xl font-bold">5-Year Warranty</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto container-padding">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          5-Stage
          <span class="gradient-text">Filtration Process</span>
        </h2>
        <p class="text-lg text-gray-600">
          Our advanced multi-stage system removes more contaminants than pitcher or
          refrigerator filters ever could.
        </p>
      </div>

      <div class="grid md:grid-cols-5 gap-4">
        <div class="bg-gradient-to-b from-primary/5 to-primary/10 rounded-xl p-6 text-center">
          <div class="w-10 h-10 bg-primary text-white rounded-full flex items-center justify-center font-bold mx-auto mb-3">1</div>
          <div class="font-bold text-gray-900 mb-1">Sediment</div>
          <div class="text-sm text-gray-600">Removes rust, sand, dirt</div>
        </div>

        <div class="bg-gradient-to-b from-primary/5 to-primary/10 rounded-xl p-6 text-center">
          <div class="w-10 h-10 bg-primary text-white rounded-full flex items-center justify-center font-bold mx-auto mb-3">2</div>
          <div class="font-bold text-gray-900 mb-1">Carbon</div>
          <div class="text-sm text-gray-600">Reduces chlorine, taste</div>
        </div>

        <div class="bg-gradient-to-b from-primary/5 to-primary/10 rounded-xl p-6 text-center">
          <div class="w-10 h-10 bg-primary text-white rounded-full flex items-center justify-center font-bold mx-auto mb-3">3</div>
          <div class="font-bold text-gray-900 mb-1">RO Membrane</div>
          <div class="text-sm text-gray-600">Removes 99% of contaminants</div>
        </div>

        <div class="bg-gradient-to-b from-primary/5 to-primary/10 rounded-xl p-6 text-center">
          <div class="w-10 h-10 bg-primary text-white rounded-full flex items-center justify-center font-bold mx-auto mb-3">4</div>
          <div class="font-bold text-gray-900 mb-1">Post-Carbon</div>
          <div class="text-sm text-gray-600">Polishes taste</div>
        </div>

        <div class="bg-gradient-to-b from-primary/5 to-primary/10 rounded-xl p-6 text-center">
          <div class="w-10 h-10 bg-primary text-white rounded-full flex items-center justify-center font-bold mx-auto mb-3">5</div>
          <div class="font-bold text-gray-900 mb-1">Alkaline</div>
          <div class="text-sm text-gray-600">Adds healthy minerals</div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto container-padding">
      <div class="grid lg:grid-cols-2 gap-12">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
            Removes These Contaminants
          </h2>
          <div class="grid grid-cols-2 gap-3">
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-gray-700">Lead</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-gray-700">Chlorine</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-gray-700">PFAS</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-gray-700">Fluoride</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-gray-700">Arsenic</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-gray-700">Nitrates</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-gray-700">Pharmaceuticals</span>
            </div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-gray-700">Microplastics</span>
            </div>
          </div>
        </div>

        <div class="bg-white rounded-2xl p-8 shadow-xl">
          <h3 class="text-2xl font-bold text-gray-900 mb-6">System Options</h3>

          <div class="space-y-4">
            <div class="border border-gray-200 rounded-xl p-4">
              <div class="flex items-center gap-3 mb-2">
                <div class="text-2xl">🔄</div>
                <div class="font-bold text-gray-900">Tank System</div>
              </div>
              <p class="text-gray-600 text-sm">Traditional storage tank. 3-5 gallon capacity. Fits under most sinks.</p>
            </div>

            <div class="border border-primary rounded-xl p-4 bg-primary/5">
              <div class="flex items-center gap-3 mb-2">
                <div class="text-2xl">⚡</div>
                <div class="font-bold text-gray-900">Tankless System</div>
                <span class="bg-primary text-white text-xs px-2 py-1 rounded-full">Popular</span>
              </div>
              <p class="text-gray-600 text-sm">On-demand filtration. No tank needed. Space-saving design.</p>
            </div>
          </div>

          <div class="mt-6 p-4 bg-gray-50 rounded-lg">
            <p class="text-gray-700 text-sm"><strong>100 GPD Capacity</strong> - Produces up to 100 gallons of pure water per day. Plenty for families.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Related Products -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto container-padding">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Other Drinking Water
          <span class="gradient-text">Options</span>
        </h2>
        <p class="text-lg text-gray-600">
          Compare our reverse osmosis systems to find your perfect fit.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
        <a href="/products/tankless-ro" class="group bg-gray-50 rounded-2xl p-8 shadow-sm hover:shadow-lg transition-all border border-gray-100 hover:border-primary/50">
          <div class="flex items-center gap-4 mb-4">
            <div class="text-4xl">⚡</div>
            <div>
              <span class="inline-block bg-primary/10 text-primary text-xs font-semibold px-2 py-1 rounded-full mb-1">800 GPD</span>
              <h3 class="text-xl font-bold text-gray-900 group-hover:text-primary transition-colors">Tankless RO System</h3>
            </div>
          </div>
          <p class="text-gray-600 mb-4">High-output tankless design. Fresh water on demand, no storage tank needed.</p>
          <span class="text-primary font-semibold">Learn More →</span>
        </a>

        <a href="/products/complete-home-system" class="group bg-gray-50 rounded-2xl p-8 shadow-sm hover:shadow-lg transition-all border border-gray-100 hover:border-primary/50">
          <div class="flex items-center gap-4 mb-4">
            <div class="text-4xl">🏠</div>
            <div>
              <span class="inline-block bg-primary/10 text-primary text-xs font-semibold px-2 py-1 rounded-full mb-1">Most Popular</span>
              <h3 class="text-xl font-bold text-gray-900 group-hover:text-primary transition-colors">Complete Home System</h3>
            </div>
          </div>
          <p class="text-gray-600 mb-4">Whole-home filtration and softening for clean water from every tap.</p>
          <span class="text-primary font-semibold">Learn More →</span>
        </a>
      </div>

      <div class="mt-12 text-center">
        <a href="/products" class="inline-flex items-center justify-center px-8 py-4 border-2 border-primary text-primary font-semibold rounded-lg hover:bg-primary hover:text-white transition-colors">
          View All Products
        </a>
      </div>
    </div>
  </section>

  <section id="contact" class="py-20 bg-primary">
    <div class="max-w-4xl mx-auto container-padding text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
        Taste the Difference
      </h2>
      <p class="text-xl text-white/90 mb-8">
        Get pure, refreshing water right from your tap. Free installation included.
      </p>
      <a href="tel:+19195551234" class="inline-flex items-center justify-center px-8 py-4 bg-white text-primary font-semibold rounded-lg hover:bg-gray-100 transition-colors">
        Call (919) 555-0123
      </a>
    </div>
  </section>

  <Footer />
</Layout>
