---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const specs = [
  { label: 'Iron Removal', value: 'Up to 15 ppm' },
  { label: 'Sulfur Removal', value: 'Up to 5 ppm' },
  { label: 'Manganese Removal', value: 'Up to 5 ppm' },
  { label: 'Media Type', value: 'Katalox Light' },
  { label: 'Tank Size', value: '10" x 54"' },
  { label: 'Valve', value: 'Digital Fleck 2510AIO' },
  { label: 'Warranty', value: '5-year warranty' },
];

const howItWorks = [
  {
    step: 'Air Injection',
    description: 'The system draws in air through an injector, creating an oxygen-rich environment in the tank.',
  },
  {
    step: 'Oxidation',
    description: 'Iron, sulfur, and manganese are oxidized (turned into particles) as they contact the oxygen.',
  },
  {
    step: 'Filtration',
    description: 'Katalox Light media traps the oxidized particles while allowing clean water to pass through.',
  },
  {
    step: 'Backwash',
    description: 'System automatically backwashes to flush trapped contaminants down the drain.',
  },
];

const problems = [
  { problem: 'Rust stains on sinks, tubs, and toilets', cause: 'High iron content' },
  { problem: 'Rotten egg smell from water', cause: 'Hydrogen sulfide gas' },
  { problem: 'Black slimy buildup', cause: 'Manganese and bacteria' },
  { problem: 'Orange staining on laundry', cause: 'Dissolved iron' },
  { problem: 'Metallic taste', cause: 'Iron and minerals' },
  { problem: 'Clogged pipes and fixtures', cause: 'Iron and manganese deposits' },
];
---

<Layout
  title="Iron & Sulfur Water Filter Raleigh | Iron Removal System NC"
  description="Remove iron, sulfur, and manganese from well water. Air injection oxidation system eliminates rust stains and rotten egg smell. 5-year warranty."
>
  <Navbar />

  <!-- Hero -->
  <section class="pt-32 pb-20 bg-gradient-to-br from-primary to-secondary">
    <div class="max-w-7xl mx-auto container-padding">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="inline-block bg-white/20 text-white text-sm font-medium px-4 py-1 rounded-full mb-4">Well Water Solution</span>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
            Iron & Sulfur
            <span class="text-accent">Removal System</span>
          </h1>
          <p class="text-xl text-white/90 mb-8">
            Eliminate rust stains and rotten egg smell. Air injection oxidation technology
            removes up to 15 ppm iron, 5 ppm sulfur, and 5 ppm manganese - no chemicals needed.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="#contact" class="btn-primary bg-white text-primary hover:bg-gray-100">
              Get Free Quote
            </a>
            <a href="tel:+19195551234" class="px-8 py-4 border-2 border-white text-white font-semibold rounded-lg hover:bg-white/10 transition-colors text-center">
              Call (919) 555-0123
            </a>
          </div>
        </div>
        <div class="bg-white/10 backdrop-blur-sm rounded-3xl p-8 border border-white/20">
          <img src="/images/products/complete-home-system.png" alt="Iron and Sulfur Removal System" class="w-full max-w-xs mx-auto mb-4 rounded-xl" />
          <div class="text-center">
            <div class="text-white text-lg mb-2">No Chemicals Needed</div>
            <div class="text-accent text-3xl font-bold">5-Year Warranty</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Problems Section -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto container-padding">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
            Signs You Need Iron & Sulfur Treatment
          </h2>
          <p class="text-gray-600 mb-8">
            Well water in the Triangle often contains iron and sulfur. These contaminants
            cause obvious problems that affect your daily life and home value.
          </p>

          <div class="space-y-4">
            {problems.map((item) => (
              <div class="flex items-start gap-4 bg-red-50 rounded-xl p-4">
                <div class="w-2 h-2 bg-red-500 rounded-full mt-2 flex-shrink-0"></div>
                <div>
                  <p class="font-medium text-gray-900">{item.problem}</p>
                  <p class="text-sm text-gray-500">Cause: {item.cause}</p>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div class="bg-gradient-to-br from-primary/10 to-secondary/10 rounded-2xl p-8">
          <h3 class="text-2xl font-bold text-gray-900 mb-6">What We Remove</h3>

          <div class="space-y-6">
            <div class="bg-white rounded-xl p-6 shadow-sm">
              <div class="flex items-center gap-3 mb-2">
                <div class="w-12 h-12 bg-orange-100 rounded-full flex items-center justify-center text-orange-600 font-bold">Fe</div>
                <h4 class="text-xl font-bold text-gray-900">Iron</h4>
              </div>
              <p class="text-gray-600">Removes up to <strong>15 ppm</strong> iron. Eliminates rust stains, metallic taste, and orange water.</p>
            </div>

            <div class="bg-white rounded-xl p-6 shadow-sm">
              <div class="flex items-center gap-3 mb-2">
                <div class="w-12 h-12 bg-yellow-100 rounded-full flex items-center justify-center text-yellow-600 font-bold">S</div>
                <h4 class="text-xl font-bold text-gray-900">Sulfur</h4>
              </div>
              <p class="text-gray-600">Removes up to <strong>5 ppm</strong> sulfur. Stops rotten egg smell in one day.</p>
            </div>

            <div class="bg-white rounded-xl p-6 shadow-sm">
              <div class="flex items-center gap-3 mb-2">
                <div class="w-12 h-12 bg-gray-800 rounded-full flex items-center justify-center text-white font-bold">Mn</div>
                <h4 class="text-xl font-bold text-gray-900">Manganese</h4>
              </div>
              <p class="text-gray-600">Removes up to <strong>5 ppm</strong> manganese. Stops black staining and buildup.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto container-padding">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          How Air Injection
          <span class="gradient-text">Technology Works</span>
        </h2>
        <p class="text-lg text-gray-600">
          Chemical-free oxidation process removes iron and sulfur naturally.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        {howItWorks.map((item, index) => (
          <div class="bg-white rounded-2xl p-6 shadow-lg">
            <div class="w-12 h-12 bg-primary rounded-full flex items-center justify-center text-white text-xl font-bold mb-4">{index + 1}</div>
            <h3 class="text-lg font-bold text-gray-900 mb-2">{item.step}</h3>
            <p class="text-gray-600 text-sm">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Specs & Benefits -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto container-padding">
      <div class="grid lg:grid-cols-2 gap-12">
        <div class="bg-gray-50 rounded-2xl p-8">
          <h3 class="text-2xl font-bold text-gray-900 mb-6">System Specifications</h3>
          <div class="space-y-4">
            {specs.map((spec) => (
              <div class="flex justify-between py-3 border-b border-gray-200">
                <span class="text-gray-600">{spec.label}</span>
                <span class="font-semibold text-gray-900">{spec.value}</span>
              </div>
            ))}
          </div>
        </div>

        <div class="bg-gray-50 rounded-2xl p-8">
          <h3 class="text-2xl font-bold text-gray-900 mb-6">Key Benefits</h3>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-gray-700"><strong>No Chemicals:</strong> Natural air injection - no chlorine or peroxide needed</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-gray-700"><strong>Automatic:</strong> Digital valve handles all cycles automatically</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-gray-700"><strong>High Capacity:</strong> Handles even severe iron and sulfur levels</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-gray-700"><strong>Long Media Life:</strong> Katalox media lasts 7-10 years</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-gray-700"><strong>Low Maintenance:</strong> Just check salt for softener (if paired)</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Combo Systems -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto container-padding">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Recommended Pairings
        </h2>
        <p class="text-lg text-gray-600">
          Iron & sulfur systems work best as part of a complete water treatment solution.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        <div class="bg-white rounded-2xl p-8 shadow-lg border-2 border-primary">
          <h3 class="text-2xl font-bold text-gray-900 mb-4">Iron Filter + Softener</h3>
          <p class="text-gray-600 mb-4">
            Remove iron first, then soften the water. The complete well water solution.
          </p>
          <ul class="space-y-2 mb-6">
            <li class="flex items-center gap-2 text-gray-700">
              <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Removes iron, sulfur, and hardness
            </li>
            <li class="flex items-center gap-2 text-gray-700">
              <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Protects softener resin from iron damage
            </li>
            <li class="flex items-center gap-2 text-gray-700">
              <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Best for well water with multiple issues
            </li>
          </ul>
          <a href="/products/dual-tank-softener" class="text-primary font-semibold hover:underline">Learn About Dual Tank Systems →</a>
        </div>

        <div class="bg-white rounded-2xl p-8 shadow-lg">
          <h3 class="text-2xl font-bold text-gray-900 mb-4">Iron Filter + Sediment Filter</h3>
          <p class="text-gray-600 mb-4">
            Pre-filter sediment before the iron filter for maximum efficiency.
          </p>
          <ul class="space-y-2 mb-6">
            <li class="flex items-center gap-2 text-gray-700">
              <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Extends iron filter media life
            </li>
            <li class="flex items-center gap-2 text-gray-700">
              <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Stops sand and silt
            </li>
            <li class="flex items-center gap-2 text-gray-700">
              <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
              Lower maintenance costs
            </li>
          </ul>
          <a href="/products/pre-sediment-filter" class="text-primary font-semibold hover:underline">Learn About Sediment Filters →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section id="contact" class="py-20 bg-primary">
    <div class="max-w-4xl mx-auto container-padding text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
        Stop Iron & Sulfur Problems Today
      </h2>
      <p class="text-xl text-white/90 mb-8">
        Get a free water test and custom quote for your iron and sulfur removal system.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="tel:+19195551234" class="px-8 py-4 bg-white text-primary font-semibold rounded-lg hover:bg-gray-100 transition-colors">
          Call (919) 555-0123
        </a>
        <a href="/#contact" class="px-8 py-4 bg-white/20 text-white font-semibold rounded-lg hover:bg-white/30 transition-colors">
          Schedule Free Test
        </a>
      </div>
    </div>
  </section>

  <!-- Schema -->
  <script type="application/ld+json" slot="head">
    {JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Product",
      "name": "Iron and Sulfur Removal System",
      "description": "Air injection oxidation system for iron, sulfur, and manganese removal from well water",
      "brand": {
        "@type": "Brand",
        "name": "Raleigh Water Solutions"
      },
      "offers": {
        "@type": "Offer",
        "availability": "https://schema.org/InStock",
        "priceCurrency": "USD",
        "seller": {
          "@type": "LocalBusiness",
          "name": "Raleigh Water Solutions"
        }
      }
    })}
  </script>

  <Footer />
</Layout>
