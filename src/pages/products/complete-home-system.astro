---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="Complete Home Water Filtration System | Raleigh Water Solutions"
  description="Whole-house water filtration and softening system for Raleigh homes. Removes contaminants, softens hard water, protects appliances. Free installation and lifetime warranty."
>
  <Navbar />

  <!-- Hero -->
  <section class="pt-32 pb-20 bg-gradient-to-br from-primary to-secondary">
    <div class="max-w-7xl mx-auto container-padding">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="inline-block bg-white/20 text-white text-sm font-medium px-4 py-1 rounded-full mb-4">Most Popular</span>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
            Complete Home
            <span class="text-accent">Water System</span>
          </h1>
          <p class="text-xl text-white/90 mb-8">
            The ultimate whole-house solution. Clean, soft water from every tap.
            Professional installation with lifetime warranty included.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="#contact" class="btn-primary bg-white text-primary hover:bg-gray-100">
              Get Free Quote
            </a>
            <a href="tel:+19195551234" class="px-8 py-4 border-2 border-white text-white font-semibold rounded-lg hover:bg-white/10 transition-colors text-center">
              Call (919) 555-0123
            </a>
          </div>
        </div>
        <div class="bg-white/10 backdrop-blur-sm rounded-3xl p-8 border border-white/20">
          <img src="/images/products/complete-home-system.png" alt="Complete Home Water System" class="w-full max-w-xs mx-auto mb-4 rounded-xl" />
          <div class="text-center">
            <div class="text-white text-lg mb-2">Professional Installation</div>
            <div class="text-accent text-3xl font-bold">Lifetime Warranty</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits -->
  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto container-padding">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Why Raleigh Homeowners Choose Our
          <span class="gradient-text">Complete System</span>
        </h2>
        <p class="text-lg text-gray-600">
          Designed specifically for Triangle area water conditions. The hardest water
          in the country meets its match.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="bg-gray-50 rounded-2xl p-8">
          <div class="w-14 h-14 bg-primary/10 rounded-xl flex items-center justify-center text-3xl mb-4">💧</div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Whole-Home Filtration</h3>
          <p class="text-gray-600">Removes chlorine, chloramines, sediment, and volatile organic compounds from every tap in your home.</p>
        </div>

        <div class="bg-gray-50 rounded-2xl p-8">
          <div class="w-14 h-14 bg-secondary/10 rounded-xl flex items-center justify-center text-3xl mb-4">✨</div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Water Softening</h3>
          <p class="text-gray-600">Premium ion exchange resin eliminates hard water minerals. Softer skin, shinier hair, and protected appliances.</p>
        </div>

        <div class="bg-gray-50 rounded-2xl p-8">
          <div class="w-14 h-14 bg-accent/20 rounded-xl flex items-center justify-center text-3xl mb-4">🛡️</div>
          <h3 class="text-xl font-bold text-gray-900 mb-3">Heavy Metal Removal</h3>
          <p class="text-gray-600">Advanced filtration reduces lead, mercury, and other contaminants commonly found in municipal water supplies.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto container-padding">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
            What's Included
          </h2>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-gray-700"><strong>NSF Certified Components</strong> - Tested and certified to reduce harmful contaminants</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-gray-700"><strong>Digital Control Head</strong> - Smart regeneration based on actual water usage</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-gray-700"><strong>Salt-Efficient Design</strong> - Up to 40% less salt usage than standard softeners</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-gray-700"><strong>Bypass Valve</strong> - Easy maintenance without shutting off water to your home</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-gray-700"><strong>Lifetime Warranty</strong> - Complete coverage on tanks, valves, and electronics</span>
            </li>
          </ul>
        </div>

        <div class="bg-white rounded-2xl p-8 shadow-xl">
          <h3 class="text-2xl font-bold text-gray-900 mb-6">Perfect For:</h3>
          <ul class="space-y-3 mb-8">
            <li class="flex items-center gap-3 text-gray-700">
              <span class="w-2 h-2 bg-primary rounded-full"></span>
              Homes with hard water (7+ grains per gallon)
            </li>
            <li class="flex items-center gap-3 text-gray-700">
              <span class="w-2 h-2 bg-primary rounded-full"></span>
              Families wanting cleaner, safer water
            </li>
            <li class="flex items-center gap-3 text-gray-700">
              <span class="w-2 h-2 bg-primary rounded-full"></span>
              Homeowners with new appliances to protect
            </li>
            <li class="flex items-center gap-3 text-gray-700">
              <span class="w-2 h-2 bg-primary rounded-full"></span>
              Anyone tired of dry skin and dull hair
            </li>
            <li class="flex items-center gap-3 text-gray-700">
              <span class="w-2 h-2 bg-primary rounded-full"></span>
              Houses with 2+ bathrooms
            </li>
          </ul>

          <div class="bg-green-50 rounded-xl p-6 border border-green-200">
            <div class="flex items-center gap-2 text-green-700 font-semibold mb-2">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              Save up to 40%
            </div>
            <p class="text-green-700 text-sm">Limited time offer. Professional installation included.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section id="contact" class="py-20 bg-primary">
    <div class="max-w-4xl mx-auto container-padding text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
        Ready for Clean, Soft Water?
      </h2>
      <p class="text-xl text-white/90 mb-8">
        Get a free in-home consultation and water test. No obligation, no pressure.
      </p>
      <a href="tel:+19195551234" class="inline-flex items-center justify-center px-8 py-4 bg-white text-primary font-semibold rounded-lg hover:bg-gray-100 transition-colors">
        Call (919) 555-0123
      </a>
    </div>
  </section>

  <Footer />
</Layout>
