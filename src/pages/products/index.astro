---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';

const heroProducts = [
  {
    name: 'HW800 AlkaPro',
    subtitle: 'Tankless RO System',
    description: '800 GPD tankless reverse osmosis with alkaline filtration. Fresh water on demand, no storage tank needed.',
    image: '/images/products/tankless-ro.png',
    badge: 'Most Popular',
    href: '/products/tankless-ro',
    features: [
      '800 GPD Tankless RO System',
      'Alkaline pH Balancing',
      'Color Match Faucet Available',
      'Quick-Change Filters',
      'Space-Saving Design',
    ],
    warranty: '5-Year Warranty',
  },
  {
    name: '5-Stage RO System',
    subtitle: 'Traditional Tank System',
    description: '5-stage advanced filtration with storage tank. Proven reliability for crystal-clear drinking water.',
    image: '/images/products/tankless-ro.png',
    badge: 'Best Value',
    href: '/products/reverse-osmosis',
    features: [
      '5-Stage Advanced Filtration',
      '100 GPD Capacity',
      'Storage Tank Included',
      'Alkaline Option Available',
      'NSF Certified Components',
    ],
    warranty: '5-Year Warranty',
  },
];

const wholeHomeSystems = [
  {
    name: 'Complete Home System',
    description: 'Whole-house filtration + softening in one system.',
    image: '/images/products/complete-home-system.png',
    badge: 'Best Seller',
    href: '/products/complete-home-system',
  },
  {
    name: 'Softener + Carbon Filter',
    description: '2-in-1 system for city water with chlorine.',
    image: '/images/products/water-softener.png',
    badge: '2-in-1',
    href: '/products/softener-with-carbon',
  },
  {
    name: 'Single Tank Softener',
    description: 'Efficient softening for city water homes.',
    image: '/images/products/water-softener.png',
    badge: 'City Water',
    href: '/products/single-tank-softener',
  },
  {
    name: 'Dual Tank Softener',
    description: 'Continuous soft water for well water.',
    image: '/images/products/water-softener.png',
    badge: 'Well Water',
    href: '/products/dual-tank-softener',
  },
];

const faucetFinishes = [
  { name: 'Chrome', class: 'bg-gradient-to-br from-gray-300 to-gray-500' },
  { name: 'Brushed Nickel', class: 'bg-gradient-to-br from-gray-400 to-gray-600' },
  { name: 'Matte Black', class: 'bg-gradient-to-br from-gray-800 to-black' },
  { name: 'Brushed Gold', class: 'bg-gradient-to-br from-yellow-400 to-yellow-600' },
];

const benefits = [
  { icon: '🔬', title: 'Free Water Testing', description: 'We test your water and recommend the perfect system' },
  { icon: '⚡', title: 'Same-Week Installation', description: 'Professional installation in 2-4 hours' },
  { icon: '🛡️', title: '5-Year Warranty', description: 'Complete coverage on all systems' },
  { icon: '💰', title: 'Best Price Guarantee', description: 'We beat any competitor quote' },
];
---

<Layout
  title="Water Filtration Systems Raleigh | Whole House, Softener & RO NC"
  description="Professional water filtration systems in Raleigh. Whole house filters, water softeners, RO systems, and well water treatment. Free water testing and 5-year warranty."
>
  <Navbar />

  <!-- Hero -->
  <section class="pt-32 pb-20 bg-gradient-to-br from-primary to-secondary relative overflow-hidden">
    <div class="absolute inset-0 opacity-5">
      <div class="absolute top-0 left-0 w-full h-full" style="background-image: url('/images/water-pattern.svg'); background-size: 200px;"></div>
    </div>

    <div class="max-w-7xl mx-auto container-padding relative z-10">
      <div class="text-center max-w-4xl mx-auto">
        <span class="inline-block bg-white/20 text-white text-sm font-medium px-4 py-2 rounded-full mb-6">Save up to 40% - Limited Time</span>

        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
          Water Filtration Systems for
          <span class="text-accent">Raleigh Homes</span>
        </h1>

        <p class="text-xl text-white/90 mb-8 max-w-2xl mx-auto">
          Whole house systems, water softeners, reverse osmosis, and well water treatment.
          Professional installation with 5-year warranty.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="#drinking-water" class="btn-primary bg-white text-primary hover:bg-gray-100 text-lg px-8 py-4">
            Drinking Water Systems
          </a>
          <a href="#whole-home" class="px-8 py-4 border-2 border-white text-white font-semibold rounded-lg hover:bg-white/10 transition-colors text-lg">
            Whole Home Systems
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Benefits Bar -->
  <section class="py-12 bg-white border-b">
    <div class="max-w-7xl mx-auto container-padding">
      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
        {benefits.map((benefit) => (
          <div class="flex items-center gap-4">
            <div class="text-3xl">{benefit.icon}</div>
            <div>
              <h3 class="font-bold text-gray-900">{benefit.title}</h3>
              <p class="text-sm text-gray-600">{benefit.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Drinking Water Systems (Hero Products) -->
  <section id="drinking-water" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto container-padding">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="inline-block text-primary font-semibold text-sm uppercase tracking-wider mb-3">Drinking Water</span>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-6">
          Reverse Osmosis
          <span class="gradient-text">Systems</span>
        </h2>
        <p class="text-lg text-gray-600">
          Crystal-clear, purified drinking water right from your kitchen tap. Choose between tankless on-demand or traditional tank systems.
        </p>
      </div>

      <!-- Product Cards - Vertical Layout -->
      <div class="space-y-12">
        {heroProducts.map((product) => (
          <div class="bg-white rounded-3xl shadow-xl border border-gray-100 overflow-hidden">
            <div class="grid lg:grid-cols-2 gap-0">
              <!-- Product Image -->
              <div class="bg-gradient-to-br from-gray-50 to-gray-100 p-8 lg:p-12 flex items-center justify-center relative">
                {product.badge && (
                  <span class="absolute top-6 left-6 bg-primary text-white text-sm font-semibold px-4 py-2 rounded-full">
                    {product.badge}
                  </span>
                )}
                <img src={product.image} alt={product.name} class="w-full max-w-sm object-contain" />
              </div>

              <!-- Product Info -->
              <div class="p-8 lg:p-12 flex flex-col justify-center">
                <h3 class="text-sm text-primary font-semibold uppercase tracking-wider mb-2">{product.subtitle}</h3>
                <h4 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">{product.name}</h4>
                <p class="text-gray-600 text-lg mb-6">{product.description}</p>

                <ul class="space-y-3 mb-8">
                  {product.features.map((feature) => (
                    <li class="flex items-center gap-3">
                      <svg class="w-5 h-5 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                      </svg>
                      <span class="text-gray-700">{feature}</span>
                    </li>
                  ))}
                </ul>

                <div class="flex flex-col sm:flex-row gap-4">
                  <a href={product.href} class="btn-primary text-center">
                    Learn More
                  </a>
                  <a href="tel:+19195551234" class="px-6 py-3 border-2 border-gray-200 text-gray-700 font-semibold rounded-lg hover:border-primary hover:text-primary transition-colors text-center">
                    {product.warranty}
                  </a>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Faucet Finishes -->
      <div class="mt-16">
        <h3 class="text-xl font-bold text-center text-gray-900 mb-8">
          Color Match Faucet To Your Appliances
        </h3>
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 max-w-3xl mx-auto">
          {faucetFinishes.map((finish) => (
            <div class="text-center">
              <div class={`w-20 h-20 rounded-full mx-auto mb-3 shadow-lg ${finish.class}`}></div>
              <span class="font-medium text-gray-700">{finish.name}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Whole Home Systems -->
  <section id="whole-home" class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto container-padding">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <span class="inline-block text-primary font-semibold text-sm uppercase tracking-wider mb-3">Whole Home</span>
        <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-6">
          Water Softeners &
          <span class="gradient-text">Filtration</span>
        </h2>
        <p class="text-lg text-gray-600">
          Complete water treatment solutions for every tap in your home. Filter, soften, and protect your entire plumbing system.
        </p>
      </div>

      <div class="grid md:grid-cols-2 gap-8">
        {wholeHomeSystems.map((product) => (
          <a href={product.href} class="group bg-white rounded-2xl p-8 shadow-sm hover:shadow-xl transition-all duration-300 border border-gray-100 hover:border-primary/50">
            <div class="flex flex-col h-full">
              <div class="flex items-start justify-between mb-6">
                <div class="w-32 h-32 bg-gray-50 rounded-xl p-4 flex items-center justify-center">
                  <img src={product.image} alt={product.name} class="w-full h-full object-contain group-hover:scale-105 transition-transform" />
                </div>
                {product.badge && (
                  <span class="bg-primary/10 text-primary text-xs font-semibold px-3 py-1 rounded-full">
                    {product.badge}
                  </span>
                )}
              </div>

              <h3 class="text-xl font-bold text-gray-900 mb-2 group-hover:text-primary transition-colors">{product.name}</h3>
              <p class="text-gray-600 mb-6 flex-grow">{product.description}</p>

              <div class="flex items-center justify-between pt-4 border-t border-gray-100">
                <span class="text-primary font-semibold flex items-center gap-2">
                  View Details
                  <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                </span>
                <span class="text-sm text-gray-400">5-Year Warranty</span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- Additional Systems Link -->
      <div class="mt-12 text-center">
        <a href="#all-systems" class="inline-flex items-center gap-2 text-primary font-semibold hover:underline">
          View All Whole Home Systems
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- All Systems Grid -->
  <section id="all-systems" class="py-20 bg-white">
    <div class="max-w-7xl mx-auto container-padding">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
          Complete Product
          <span class="gradient-text">Catalog</span>
        </h2>
        <p class="text-lg text-gray-600">
          Browse our full selection of water treatment solutions.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        <!-- Well Water -->
        <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-2xl p-8">
          <h3 class="text-xl font-bold text-gray-900 mb-4">Well Water Solutions</h3>
          <ul class="space-y-3 mb-6">
            <li>
              <a href="/products/well-water-system" class="text-gray-700 hover:text-primary flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-primary rounded-full"></span>
                Complete Well Water System
              </a>
            </li>
            <li>
              <a href="/products/iron-sulfur-filter" class="text-gray-700 hover:text-primary flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-primary rounded-full"></span>
                Iron & Sulfur Filter
              </a>
            </li>
          </ul>
        </div>

        <!-- Add-Ons -->
        <div class="bg-gradient-to-br from-green-50 to-green-100 rounded-2xl p-8">
          <h3 class="text-xl font-bold text-gray-900 mb-4">Add-Ons & Upgrades</h3>
          <ul class="space-y-3 mb-6">
            <li>
              <a href="/products/pre-sediment-filter" class="text-gray-700 hover:text-primary flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-primary rounded-full"></span>
                Pre-Sediment Filter
              </a>
            </li>
            <li>
              <a href="/products/uv-sterilizer" class="text-gray-700 hover:text-primary flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-primary rounded-full"></span>
                UV Sterilizer
              </a>
            </li>
            <li>
              <a href="/products/carbon-filter" class="text-gray-700 hover:text-primary flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-primary rounded-full"></span>
                Carbon Filter
              </a>
            </li>
          </ul>
        </div>

        <!-- Specialized -->
        <div class="bg-gradient-to-br from-purple-50 to-purple-100 rounded-2xl p-8">
          <h3 class="text-xl font-bold text-gray-900 mb-4">Specialty Systems</h3>
          <ul class="space-y-3 mb-6">
            <li>
              <a href="/products/salt-free-conditioner" class="text-gray-700 hover:text-primary flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-primary rounded-full"></span>
                Salt-Free Conditioner
              </a>
            </li>
            <li>
              <a href="/products/softener-with-carbon" class="text-gray-700 hover:text-primary flex items-center gap-2">
                <span class="w-1.5 h-1.5 bg-primary rounded-full"></span>
                Softener + Carbon Combo
              </a>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Why Choose Us -->
  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto container-padding">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="inline-block text-primary font-semibold text-sm uppercase tracking-wider mb-3">Why Raleigh Water Solutions</span>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
            Raleigh's Most Trusted
            <span class="gradient-text">Water Treatment Experts</span>
          </h2>
          <p class="text-gray-600 mb-6">
            We've served over 500 homes in the Triangle area. Our local expertise means we
            understand Raleigh's water challenges - from municipal chlorine to well water iron.
          </p>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-gray-700"><strong>Local Experts:</strong> Born and raised in the Triangle</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-gray-700"><strong>5-Year Warranty:</strong> Complete coverage on all systems</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-gray-700"><strong>Free Water Testing:</strong> Comprehensive analysis included</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-gray-700"><strong>Best Price Guarantee:</strong> We beat any competitor's price</span>
            </li>
          </ul>
        </div>

        <div class="bg-white rounded-2xl p-8 shadow-xl">
          <h3 class="text-2xl font-bold text-gray-900 mb-6">Get Your Free Quote</h3>
          <p class="text-gray-600 mb-6">
            Schedule your complimentary water test and consultation.
            We'll analyze your water and recommend the perfect system.
          </p>

          <a href="tel:+19195551234" class="btn-primary w-full text-center block mb-4">
            Call (919) 555-0123
          </a>

          <a href="/#contact" class="btn-outline w-full text-center block">
            Schedule Online
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Schema -->
  <script type="application/ld+json" slot="head">
    {JSON.stringify({
      "@context": "https://schema.org",
      "@type": "ItemList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Whole House Water Filtration",
          "url": "/products/complete-home-system"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Water Softener Systems",
          "url": "/products/water-softener-pro"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Reverse Osmosis Systems",
          "url": "/products/reverse-osmosis"
        },
        {
          "@type": "ListItem",
          "position": 4,
          "name": "Well Water Treatment",
          "url": "/products/well-water-system"
        }
      ]
    })}
  </script>

  <Footer />
</Layout>
