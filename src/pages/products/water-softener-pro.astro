---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="Water Softener Pro | Raleigh Water Solutions"
  description="Professional water softener installation in Raleigh. Eliminate hard water problems, protect appliances, reduce soap usage. Free installation and 10-year warranty."
>
  <Navbar />

  <section class="pt-32 pb-20 bg-gradient-to-br from-primary to-secondary">
    <div class="max-w-7xl mx-auto container-padding">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="inline-block bg-white/20 text-white text-sm font-medium px-4 py-1 rounded-full mb-4">Best Value</span>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
            Water Softener
            <span class="text-accent">Pro</span>
          </h1>
          <p class="text-xl text-white/90 mb-8">
            Eliminate hard water for good. Softer skin, cleaner dishes, and protected appliances.
            Professional installation with 10-year warranty.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="#contact" class="btn-primary bg-white text-primary hover:bg-gray-100">
              Get Free Quote
            </a>
            <a href="tel:+19195551234" class="px-8 py-4 border-2 border-white text-white font-semibold rounded-lg hover:bg-white/10 transition-colors text-center">
              Call (919) 555-0123
            </a>
          </div>
        </div>
        <div class="bg-white/10 backdrop-blur-sm rounded-3xl p-8 border border-white/20">
          <div class="text-center">
            <div class="text-6xl mb-4">✨</div>
            <div class="text-white text-lg mb-2">Professional Installation</div>
            <div class="text-accent text-3xl font-bold">10-Year Warranty</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto container-padding">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Say Goodbye to
          <span class="gradient-text">Hard Water</span>
        </h2>
        <p class="text-lg text-gray-600">
          Triangle area water averages 7-10 grains per gallon. Our Water Softener Pro
          is built to handle the toughest hard water in North Carolina.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="bg-gray-50 rounded-xl p-6 text-center">
          <div class="text-4xl mb-3">🧼</div>
          <div class="text-3xl font-bold text-primary mb-1">75%</div>
          <div class="text-gray-600">Less soap and shampoo needed</div>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 text-center">
          <div class="text-4xl mb-3">🔌</div>
          <div class="text-3xl font-bold text-primary mb-1">Protected</div>
          <div class="text-gray-600">Appliances last longer</div>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 text-center">
          <div class="text-4xl mb-3">👕</div>
          <div class="text-3xl font-bold text-primary mb-1">Softer</div>
          <div class="text-gray-600">Clothes feel better</div>
        </div>

        <div class="bg-gray-50 rounded-xl p-6 text-center">
          <div class="text-4xl mb-3">💆</div>
          <div class="text-3xl font-bold text-primary mb-1">Healthier</div>
          <div class="text-gray-600">Skin and hair feel amazing</div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto container-padding">
      <div class="grid lg:grid-cols-2 gap-12">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
            Smart Features
          </h2>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-gray-700"><strong>Digital Control Head</strong> - Programmable settings for optimal efficiency</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-gray-700"><strong>Salt-Efficient Design</strong> - Uses up to 40% less salt</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-gray-700"><strong>High-Capacity Resin</strong> - Premium ion exchange technology</span>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <span class="text-gray-700"><strong>Demand Initiated Regeneration</strong> - Only regenerates when needed</span>
            </li>
          </ul>
        </div>

        <div class="bg-white rounded-2xl p-8 shadow-xl">
          <h3 class="text-2xl font-bold text-gray-900 mb-4">Signs You Need a Softener</h3>
          <ul class="space-y-3">
            <li class="flex items-center gap-3 text-gray-700">
              <span class="text-red-500">✗</span>
              White spots on dishes and glassware
            </li>
            <li class="flex items-center gap-3 text-gray-700">
              <span class="text-red-500">✗</span>
              Dry, itchy skin after showering
            </li>
            <li class="flex items-center gap-3 text-gray-700">
              <span class="text-red-500">✗</span>
              Soap doesn't lather well
            </li>
            <li class="flex items-center gap-3 text-gray-700">
              <span class="text-red-500">✗</span>
              Scale buildup on faucets
            </li>
            <li class="flex items-center gap-3 text-gray-700">
              <span class="text-red-500">✗</span>
              Appliances wearing out quickly
            </li>
          </ul>

          <div class="mt-6 p-4 bg-green-50 rounded-lg border border-green-200">
            <p class="text-green-800 font-medium">✓ We can fix all of these problems!</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="contact" class="py-20 bg-primary">
    <div class="max-w-4xl mx-auto container-padding text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
        Ready to Soften Your Water?
      </h2>
      <p class="text-xl text-white/90 mb-8">
        Get a free water hardness test and quote. See the difference soft water makes.
      </p>
      <a href="tel:+19195551234" class="inline-flex items-center justify-center px-8 py-4 bg-white text-primary font-semibold rounded-lg hover:bg-gray-100 transition-colors">
        Call (919) 555-0123
      </a>
    </div>
  </section>

  <Footer />
</Layout>
