---
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<Layout
  title="Pre-Sediment Filter | Raleigh Water Solutions"
  description="Whole house sediment filter for Raleigh homes. Protects appliances and plumbing from rust, sand, and debris. Easy DIY filter changes."
>
  <Navbar />

  <section class="pt-32 pb-20 bg-gradient-to-br from-primary to-secondary">
    <div class="max-w-7xl mx-auto container-padding">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="inline-block bg-white/20 text-white text-sm font-medium px-4 py-1 rounded-full mb-4">Add-On</span>
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
            Pre-Sediment
            <span class="text-accent">Filter</span>
          </h1>
          <p class="text-xl text-white/90 mb-8">
            Your first line of defense against sediment, rust, and debris.
            Protects your entire plumbing system and extends appliance life.
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a href="#contact" class="btn-primary bg-white text-primary hover:bg-gray-100">
              Get Free Quote
            </a>
            <a href="tel:+19195551234" class="px-8 py-4 border-2 border-white text-white font-semibold rounded-lg hover:bg-white/10 transition-colors text-center">
              Call (919) 555-0123
            </a>
          </div>
        </div>
        <div class="bg-white/10 backdrop-blur-sm rounded-3xl p-8 border border-white/20">
          <div class="text-center">
            <div class="text-6xl mb-4">🛡️</div>
            <div class="text-white text-lg mb-2">Whole House Protection</div>
            <div class="text-accent text-3xl font-bold">1-Year Warranty</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-white">
    <div class="max-w-7xl mx-auto container-padding">
      <div class="text-center max-w-3xl mx-auto mb-16">
        <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">
          Protect Your
          <span class="gradient-text">Entire Home</span>
        </h2>
        <p class="text-lg text-gray-600">
          Sediment and debris in your water supply can damage appliances, clog fixtures,
          and reduce the lifespan of your water heater and washing machine.
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-20 h-20 bg-primary/10 rounded-2xl flex items-center justify-center text-4xl mx-auto mb-4">🔥</div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Water Heater</h3>
          <p class="text-gray-600">Prevents sediment buildup that reduces efficiency and causes premature failure.</p>
        </div>

        <div class="text-center">
          <div class="w-20 h-20 bg-secondary/10 rounded-2xl flex items-center justify-center text-4xl mx-auto mb-4">👕</div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Washing Machine</h3>
          <p class="text-gray-600">Filters out particles that can clog inlet valves and damage clothing.</p>
        </div>

        <div class="text-center">
          <div class="w-20 h-20 bg-accent/20 rounded-2xl flex items-center justify-center text-4xl mx-auto mb-4">🚿</div>
          <h3 class="text-xl font-bold text-gray-900 mb-2">Shower Heads</h3>
          <p class="text-gray-600">Keeps fixtures flowing freely and prevents unsightly mineral deposits.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto container-padding">
      <div class="grid lg:grid-cols-2 gap-12">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-6">
            Features & Benefits
          </h2>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <div>
                <strong class="text-gray-900">Captures Rust & Sand</strong>
                <p class="text-gray-600 text-sm">5-micron filtration stops particles before they enter your home's plumbing.</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <div>
                <strong class="text-gray-900">Easy Filter Changes</strong>
                <p class="text-gray-600 text-sm">No tools required. Twist-off housing makes replacement quick and clean.</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <div>
                <strong class="text-gray-900">Clear Housing</strong>
                <p class="text-gray-600 text-sm">See when your filter needs changing at a glance.</p>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <svg class="w-6 h-6 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
              </svg>
              <div>
                <strong class="text-gray-900">High Flow Rate</strong>
                <p class="text-gray-600 text-sm">Up to 15 GPM. Won't reduce water pressure throughout your home.</p>
              </div>
            </li>
          </ul>
        </div>

        <div class="bg-white rounded-2xl p-8 shadow-xl">
          <h3 class="text-2xl font-bold text-gray-900 mb-6">What's Captured</h3>

          <div class="grid grid-cols-2 gap-4">
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 bg-primary rounded-full"></span>
              <span class="text-gray-700">Sand & Sediment</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 bg-primary rounded-full"></span>
              <span class="text-gray-700">Rust Particles</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 bg-primary rounded-full"></span>
              <span class="text-gray-700">Dirt & Silt</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 bg-primary rounded-full"></span>
              <span class="text-gray-700">Scale Particles</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 bg-primary rounded-full"></span>
              <span class="text-gray-700">Pipe Debris</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-2 h-2 bg-primary rounded-full"></span>
              <span class="text-gray-700">Cloudiness</span>
            </div>
          </div>

          <div class="mt-6 p-4 bg-blue-50 rounded-lg border border-blue-200">
            <p class="text-blue-800 text-sm"><strong>Recommended:</strong> Change filter every 3-6 months depending on water quality.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-20 bg-primary">
    <div class="max-w-4xl mx-auto container-padding text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
        Pair With Any System
      </h2>
      <p class="text-xl text-white/90 mb-8">
        The Pre-Sediment Filter works great as a standalone or paired with our Complete Home System.
      </p>
      <a href="tel:+19195551234" class="inline-flex items-center justify-center px-8 py-4 bg-white text-primary font-semibold rounded-lg hover:bg-gray-100 transition-colors">
        Call (919) 555-0123
      </a>
    </div>
  </section>

  <Footer />
</Layout>
