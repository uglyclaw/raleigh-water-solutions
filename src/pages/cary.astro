---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const neighborhoods = [
  'Preston',
  'Amberly',
  'Carpenter Village',
  'MacGregor Downs',
  'Highcroft',
  'Bristol',
  'Park West',
  'Kildaire Farms',
];
---

<Layout
  title="Water Filtration Cary NC | Water Softener & Whole House Systems"
  description="Cary's #1 water filtration company. Water softeners, whole house systems & RO for Cary homes. Free water testing, lifetime warranty, flexible financing."
>
  <Navbar />

  <section class="pt-32 pb-20 bg-gradient-to-br from-primary to-secondary">
    <div class="max-w-7xl mx-auto container-padding">
      <div class="max-w-3xl">
        <span class="inline-block bg-white/20 text-white text-sm font-medium px-4 py-1 rounded-full mb-4">Cary, NC</span>

        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
          Water Filtration in
          <span class="text-accent">Cary, NC</span>
        </h1>

        <p class="text-xl text-white/90 mb-8">
          Premium water solutions for Cary's finest neighborhoods. From Preston to Amberly,
          we deliver crystal-clear, soft water to every home.
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/" class="btn-primary bg-white text-primary hover:bg-gray-100">
            Get Free Water Test
          </a>
          <a href="tel:+19195550142" class="btn-outline border-white text-white hover:bg-white hover:text-primary">
            Call (919) 555-0142
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding bg-white">
    <div class="max-w-7xl mx-auto container-padding">
      <div class="grid lg:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl font-bold text-gray-900 mb-6">
            Cary Water
            <span class="gradient-text">Quality Solutions</span>
          </h2>

          <p class="text-gray-600 mb-4">
            Cary's rapid growth means varying water quality across different neighborhoods.
            Whether you're in an established community or new construction, we customize
            water solutions for your specific needs.
          </p>

          <p class="text-gray-600 mb-4">
            Cary water tends to be moderately hard, causing dry skin, spotty dishes, and
            wear on appliances. Our customers report immediate improvements in water quality
            and comfort.
          </p>

          <p class="text-gray-600 mb-6">
            We serve all Cary neighborhoods with same-week appointments available.
          </p>

          <a href="/" class="btn-primary">
            Schedule Cary Water Test
          </a>
        </div>

        <div class="bg-gradient-to-br from-primary/10 to-secondary/10 rounded-2xl p-8">
          <h3 class="text-xl font-bold text-gray-900 mb-6">Why Cary Homeowners Choose Us</h3>

          <div class="space-y-4">
            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-green-100 flex items-center justify-center text-green-600"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg></div>
              <span class="font-medium">Same-week installation</span>
            </div>

            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-green-100 flex items-center justify-center text-green-600"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg></div>
              <span class="font-medium">Financing available</span>
            </div>

            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-green-100 flex items-center justify-center text-green-600"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg></div>
              <span class="font-medium">Lifetime warranty</span>
            </div>

            <div class="flex items-center gap-3">
              <div class="w-8 h-8 rounded-full bg-green-100 flex items-center justify-center text-green-600"><svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path></svg></div>
              <span class="font-medium">Local Cary experts</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section-padding bg-gray-50">
    <div class="max-w-7xl mx-auto container-padding">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          Cary Neighborhoods We Serve
        </h2>
      </div>

      <div class="flex flex-wrap justify-center gap-3">
        {neighborhoods.map((neighborhood) => (
          <span class="px-6 py-3 bg-white rounded-full text-gray-700 font-medium shadow-sm">
            {neighborhood}
          </span>
        ))}
      </div>
    </div>
  </section>

  <Footer />
</Layout>
