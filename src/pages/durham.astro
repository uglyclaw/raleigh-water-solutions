---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const neighborhoods = [
  'Downtown Durham',
  'Southpoint',
  'Woodcroft',
  'Hope Valley',
  'American Tobacco',
  'Trinity Park',
  'Watts-Hillandale',
  'Rockwood',
];
---

<Layout
  title="Water Filtration Durham NC | Water Softener & Filtration Systems"
  description="Durham's trusted water filtration company. Whole house systems, softeners & RO for Durham homes. Free water testing, professional installation, lifetime warranty."
>
  <Navbar />

  <section class="pt-32 pb-20 bg-gradient-to-br from-primary to-secondary">
    <div class="max-w-7xl mx-auto container-padding">
      <div class="max-w-3xl">
        <span class="inline-block bg-white/20 text-white text-sm font-medium px-4 py-1 rounded-full mb-4">Durham, NC</span>

        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-white mb-6">
          Water Filtration Systems in
          <span class="text-accent">Durham, NC</span>
        </h1>

        <p class="text-xl text-white/90 mb-8">
          Complete water solutions for Durham homes. From the historic districts to new developments,
          we provide clean, soft water throughout Durham County.
        </p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/" class="btn-primary bg-white text-primary hover:bg-gray-100">
            Get Free Water Test
          </a>
          <a href="tel:+19195550142" class="btn-outline border-white text-white hover:bg-white hover:text-primary">
            Call (919) 555-0142
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="section-padding bg-white">
    <div class="max-w-7xl mx-auto container-padding">
      <div class="grid lg:grid-cols-2 gap-12">
        <div>
          <h2 class="text-3xl font-bold text-gray-900 mb-6">
            Water Quality in
            <span class="gradient-text">Durham</span>
          </h2>

          <p class="text-gray-600 mb-4">
            Durham's water supply comes from Lake Michie and Little River Reservoir. While treated to meet
            federal standards, many homeowners experience hard water, chlorine taste, and occasional
            sediment issues.
          </p>

          <p class="text-gray-600 mb-4">
            Our Durham customers typically see water hardness levels of 6-9 grains per gallon.
            This means scale buildup on fixtures, dry skin and hair, and reduced appliance efficiency.
          </p>

          <p class="text-gray-600 mb-6">
            We install whole-house systems that remove hardness, chlorine, and contaminants -
            giving you bottled-quality water from every tap.
          </p>

          <a href="/" class="btn-primary">
            Schedule Free Durham Water Test
          </a>
        </div>

        <div class="bg-gray-50 rounded-2xl p-8">
          <h3 class="text-xl font-bold text-gray-900 mb-4">Common Durham Water Issues</h3>

          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <span class="text-2xl">💧</span>
              <div>
                <strong>Hard Water</strong>
                <p class="text-gray-600 text-sm">Mineral buildup on fixtures and appliances</p>
              </div>
            </li>

            <li class="flex items-start gap-3">
              <span class="text-2xl">🧪</span>
              <div>
                <strong>Chlorine Taste</strong>
                <p class="text-gray-600 text-sm">Affects drinking water and shower experience</p>
              </div>
            </li>

            <li class="flex items-start gap-3">
              <span class="text-2xl">🏠</span>
              <div>
                <strong>Old Pipe Sediment</strong>
                <p class="text-gray-600 text-sm">Common in historic Durham neighborhoods</p>
              </div>
            </li>

            <li class="flex items-start gap-3">
              <span class="text-2xl">⚡</span>
              <div>
                <strong>Low Water Pressure</strong>
                <p class="text-gray-600 text-sm">Caused by mineral buildup in pipes</p>
              </div>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Service Areas -->
  <section class="section-padding bg-gray-50">
    <div class="max-w-7xl mx-auto container-padding">
      <div class="text-center max-w-3xl mx-auto mb-12">
        <h2 class="text-3xl font-bold text-gray-900 mb-4">
          Serving All
          <span class="gradient-text">Durham Areas</span>
        </h2>
      </div>

      <div class="flex flex-wrap justify-center gap-3">
        {neighborhoods.map((neighborhood) => (
          <span class="px-6 py-3 bg-white rounded-full text-gray-700 font-medium shadow-sm">
            {neighborhood}
          </span>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-primary">
    <div class="max-w-7xl mx-auto container-padding text-center">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">
        Ready for Better Water in Durham?
      </h2>

      <p class="text-xl text-white/90 mb-8 max-w-2xl mx-auto">
        Join hundreds of Durham homeowners who've made the switch to clean, soft water.
      </p>

      <a href="/" class="inline-flex items-center justify-center px-8 py-4 bg-white text-primary font-semibold rounded-lg hover:bg-gray-100 transition-colors">
        Get Your Free Water Test
      </a>
    </div>
  </section>

  <Footer />
</Layout>
