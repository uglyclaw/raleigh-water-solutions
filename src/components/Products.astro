---
const products = [
  {
    name: 'Complete Home System',
    description: 'The ultimate whole-house water solution. Removes contaminants, softens water, and protects every tap in your home.',
    price: 2999,
    originalPrice: 4999,
    badge: 'Most Popular',
    image: '/images/products/complete-home-system.png',
    features: [
      'Whole-home filtration',
      'Water softening included',
      'Removes chlorine & chloramines',
      'Reduces heavy metals',
      'NSF certified components',
      '5-year warranty',
    ],
    color: 'primary',
    href: '/products/complete-home-system',
  },
  {
    name: 'Water Softener Pro',
    description: 'Eliminate hard water problems. Protect your appliances, reduce soap usage, and enjoy softer skin and hair.',
    price: 1899,
    originalPrice: 2499,
    badge: 'Best Value',
    image: '/images/products/water-softener.png',
    features: [
      'Reduces soap usage 75%',
      'Protects appliances',
      'Programmable settings',
      'Salt-efficient design',
      'Digital control head',
      '10-year warranty',
    ],
    color: 'secondary',
    href: '/products/water-softener-pro',
  },
  {
    name: 'Reverse Osmosis System',
    description: 'Crystal-clear drinking water right from your kitchen tap. Removes 99% of contaminants for the purest water possible.',
    price: 1299,
    originalPrice: 1699,
    badge: null,
    image: '/images/products/tankless-ro.png',
    features: [
      '100 GPD capacity',
      'Tankless design available',
      '5-stage filtration',
      'Alkaline option included',
      'Quick-change filters',
      '5-year warranty',
    ],
    color: 'accent',
    href: '/products/reverse-osmosis',
  },
  {
    name: 'Pre-Sediment Filter',
    description: 'Protect your entire home from sediment, rust, and debris. First line of defense for your plumbing.',
    price: 399,
    originalPrice: 599,
    badge: 'Add-On',
    image: '/images/products/sediment-filter.png',
    features: [
      'Captures rust & sand',
      'Extends appliance life',
      'Easy filter changes',
      'No plumber needed',
      'Fits any home',
      '1-year warranty',
    ],
    color: 'dark',
    href: '/products/pre-sediment-filter',
  },
];
---

<section id="products" class="section-padding bg-gray-50">
  <div class="max-w-7xl mx-auto container-padding">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block text-primary font-semibold text-sm uppercase tracking-wider mb-3">Our Products</span>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-6">
        Water Solutions for
        <span class="gradient-text">Every Home</span>
      </h2>
      <p class="text-lg text-gray-600">
        From whole-house systems to drinking water filters, we have the perfect solution for your needs and budget.
      </p>
    </div>

    <div class="grid lg:grid-cols-2 gap-8">
      {products.map((product) => (
        <a href={product.href} class={`group relative bg-white rounded-2xl p-8 shadow-lg border-2 ${product.badge ? 'border-primary shadow-primary/10' : 'border-gray-100'} hover:border-primary hover:shadow-xl transition-all duration-300 block`}>
          {product.badge && (
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-primary text-white text-sm font-semibold px-4 py-1 rounded-full">
              {product.badge}
            </div>
          )}

          <div class="flex flex-col h-full">
            <div class="flex flex-col md:flex-row md:items-start gap-6 flex-1">
              <!-- Product Image -->
              <div class="w-full md:w-40 flex-shrink-0">
                <img src={product.image} alt={product.name} class="w-full h-auto max-h-48 object-contain rounded-xl group-hover:scale-105 transition-transform duration-300" loading="lazy" />
              </div>

              <!-- Product Info -->
              <div class="flex-1 min-w-0">
                <h3 class="text-xl font-bold text-gray-900 mb-2 leading-tight">{product.name}</h3>
                <p class="text-gray-600 mb-4 text-sm line-clamp-2">{product.description}</p>

                <!-- Features -->
                <ul class="space-y-1 mb-4">
                  {product.features.slice(0, 4).map((feature) => (
                    <li class="flex items-center gap-2 text-gray-700">
                      <svg class="w-4 h-4 text-green-500 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                      </svg>
                      <span class="text-sm truncate">{feature}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>

            <!-- CTA -->
            <div class="mt-auto pt-4 border-t border-gray-100 flex flex-col md:flex-row md:items-center md:justify-between gap-3">
              <div>
                <div class="text-green-600 text-sm font-semibold flex items-center gap-1">
                  <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
                  </svg>
                  Save up to {Math.round((1 - product.price/product.originalPrice) * 100)}%
                </div>
                <div class="text-xs text-gray-500">Professional Installation</div>
              </div>
              <div class="flex flex-col md:items-end gap-1">
                <span class="text-primary font-semibold group-hover:text-primary-dark transition-colors flex items-center gap-1 text-sm">
                  Learn More
                  <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                  </svg>
                </span>
                <span class="btn-primary text-sm px-4 py-2 whitespace-nowrap">Get Free Quote</span>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- View All Products Button -->
    <div class="mt-12 text-center">
      <a href="/products" class="btn-primary text-lg px-8 py-4 inline-flex items-center gap-2">
        View All Products
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </a>
      <p class="mt-4 text-gray-500 text-sm">Browse all 12+ water treatment solutions</p>
    </div>

    <!-- Trust Badges -->
    <div class="mt-12 flex flex-wrap justify-center gap-8 items-center">
      <div class="flex items-center gap-2 text-gray-600">
        <svg class="w-6 h-6 text-primary" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
        </svg>
        <span class="font-medium">NSF Certified</span>
      </div>
      <div class="flex items-center gap-2 text-gray-600">
        <svg class="w-6 h-6 text-primary" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
        </svg>
        <span class="font-medium">BBB A+ Rated</span>
      </div>
      <div class="flex items-center gap-2 text-gray-600">
        <svg class="w-6 h-6 text-primary" fill="currentColor" viewBox="0 0 20 20">
          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
        </svg>
        <span class="font-medium">Top Rated in Triangle</span>
      </div>
    </div>
  </div>
</section>
