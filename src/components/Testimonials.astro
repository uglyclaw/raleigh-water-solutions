---
const testimonials = [
  {
    name: 'Jennifer K.',
    location: 'North Raleigh',
    avatar: 'JK',
    color: 'bg-primary',
    text: "We had terrible hard water in our North Raleigh home. Raleigh Water Solutions installed a softener and the difference is night and day. No more spots on dishes and my skin feels so much better! Can't recommend them enough.",
    rating: 5,
  },
  {
    name: 'Robert M.',
    location: 'Cary',
    avatar: 'RM',
    color: 'bg-secondary',
    text: "Mike came out for the free water test, explained everything clearly, and never pressured us. The RO system they installed tastes better than any bottled water. Highly recommend these guys!",
    rating: 5,
  },
  {
    name: 'Susan D.',
    location: 'Apex',
    avatar: 'SD',
    color: 'bg-accent',
    text: "Our well water had an iron problem that other companies couldn't fix. Raleigh Water Solutions' team diagnosed it quickly and their system works perfectly. Best investment for our home.",
    rating: 5,
  },
  {
    name: 'David L.',
    location: 'Durham',
    avatar: 'DL',
    color: 'bg-primary',
    text: "Professional installation, fair pricing, and the water quality is amazing. My coffee tastes better, my showers feel better, and I'm not buying bottled water anymore. Worth every penny.",
    rating: 5,
  },
  {
    name: 'Maria G.',
    location: 'Chapel Hill',
    avatar: 'MG',
    color: 'bg-secondary',
    text: "After years of dealing with chlorine-smelling water, we finally got a whole house filter. The team was on time, professional, and cleaned up everything. Our water tastes incredible now!",
    rating: 5,
  },
  {
    name: 'James T.',
    location: 'Raleigh',
    avatar: 'JT',
    color: 'bg-accent',
    text: "Got quotes from 3 companies. Raleigh Water Solutions had the best price and most comprehensive warranty. The installation was done in one afternoon. Very happy with our decision.",
    rating: 5,
  },
];
---

<section id="reviews" class="section-padding bg-gray-50">
  <div class="max-w-7xl mx-auto container-padding">
    <div class="text-center max-w-3xl mx-auto mb-16">
      <span class="inline-block text-primary font-semibold text-sm uppercase tracking-wider mb-3">Testimonials</span>
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-gray-900 mb-6">
        What Your
        <span class="gradient-text">Neighbors Say</span>
      </h2>
      <p class="text-lg text-gray-600">
        Real reviews from homeowners across the Triangle. See why we're Raleigh's trusted water filtration company.
      </p>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
      {testimonials.map((testimonial) => (
        <div class="bg-white rounded-2xl p-8 shadow-sm hover:shadow-lg transition-shadow duration-300">
          <!-- Stars -->
          <div class="flex gap-1 mb-4">
            {[...Array(testimonial.rating)].map(() => (
              <svg class="w-5 h-5 text-yellow-400 fill-current" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
              </svg>
            ))}
          </div>

          <!-- Quote -->
          <blockquote class="text-gray-700 mb-6 leading-relaxed">"{testimonial.text}"</blockquote>

          <!-- Author -->
          <div class="flex items-center gap-4">
            <div class={`w-12 h-12 rounded-full ${testimonial.color} flex items-center justify-center text-white font-bold`}>
              {testimonial.avatar}
            </div>
            <div>
              <div class="font-semibold text-gray-900">{testimonial.name}</div>
              <div class="text-sm text-gray-500">{testimonial.location}</div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Google Reviews CTA -->
    <div class="text-center mt-12">
      <a
        href="https://google.com"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-primary hover:text-primary-dark font-medium transition-colors"
      >
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"></path>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"></path>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"></path>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"></path>
        </svg>
        See all 500+ reviews on Google
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
        </svg>
      </a>
    </div>
  </div>
</section>
